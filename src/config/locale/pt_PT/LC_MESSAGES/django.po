msgstr "Licenciado sob AGPL-3.0-ou-posterior"

#. Translators: E∘nvelope is the brand name. The ∘ is the ring operator U+2218. ReadTheDocs is a brand name.
#: src/config/settings.py:803
msgid "Read the E∘nvelope Documentation on ReadTheDocs"
msgstr "Leia a Documentação do E∘nvelope no ReadTheDocs"

#: src/config/settings.py:940
msgid "Default page size for paginated API response data"
msgstr "Tamanho padrão da página para dados da resposta da API paginados"

#: src/config/settings.py:945
msgid "Maximum page size for paginated API response data"
msgstr "Tamanho máximo da página para dados de resposta da API paginados"

#: src/config/settings.py:950
msgid "Default page size for pagination in the webapp."
msgstr "Tamanho padrão da página para paginação na webapp."

#: src/config/settings.py:956
msgid ""
"Page size options for pagination in the webapp. Should contain the "
"WEB_DEFAULT_PAGE_SIZE value."
msgstr ""
"Opções de tamanho da página para paginação na webapp. Deve conter o valor "
"WEB_DEFAULT_PAGE_SIZE."

#: src/config/settings.py:963
msgid ""
"Maximum datasize for a thumbnail in the webapp. Thumbnails larger than this "
"will not be loaded."
msgstr ""
"Tamanho máximo dos dados para uma miniatura na webapp. Miniaturas maiores "
"que isto não serão carregadas."

#: src/config/settings.py:969
msgid "Whether to show tooltips in the web interface."
msgstr "Se as dicas de ferramentas devem ser exibidas na interface web."

#: src/config/settings.py:974
msgid "Maximum numbers of files in one storage unit."
msgstr "Número máximo de ficheiros em uma unidade de armazenamento."

#: src/config/settings.py:979
msgid "Whether or not to ignore emails and mailboxes that have a spam flag"
msgstr ""
"Se os emails e caixas de correio marcadas como spam devem ser ignoradas"

#: src/config/settings.py:985
msgid ""
"Regex pattern (case-insensitive) for mailbox names that are ignored when "
"looking up mailboxes in an account."
msgstr ""
"Padrão de regex (ignora capitalização de texto) para nomes de caixas de "
"correio que são ignoradas ao procurar caixas de correio em uma conta."

#: src/config/settings.py:991
msgid "List of content types prefixes to not parse as files."
msgstr "Lista de prefixos de conteúdo a não analisar como ficheiros."

#: src/config/settings.py:997
msgid ""
"List of content types prefixes to not parse as files. Plain and HTML text is "
"always ignored as its the bodytext."
msgstr ""
"Lista de prefixos de tipos de conteúdos a não analisar como ficheiros. "
"Ficheiros de texto simples e HTML são sempre ignorados bem com o corpo de "
"texto."

#: src/config/settings.py:1004
msgid ""
"Html template used to render emails to html. Uses the django template syntax "
"and has access to all fields of the email database table. Removing template "
"tag imports may result in 500 responses when requesting pages with email "
"thumbnails, so be careful."
msgstr ""
"Modelo html usado para renderizar emails para html. Usa o modelo de sintaxe "
"django e tem acesso a todos os campos da tabela da base de dados do email. "
"Remover a etiqueta de importes de modelo pode resultar em respostas 500 ao "
"pedir páginas com miniaturas de email, por isso tenha cuidado."

#: src/config/settings.py:1011
msgid ""
"Css style used to render emails to html. Refer to HTML_TEMPLATE for context "
"on the classes."
msgstr ""
"Estilo css usado para renderizar emails para html. Consulte HTML_TEMPLATE "
"para contexto nas classes."

#: src/config/settings.py:1017
msgid "Default mailbox setting whether to store mails as eml."
msgstr ""
"Definição padrão da caixa de correio se armazena-se emails enquanto eml ou "
"não."

#: src/config/settings.py:1022
msgid "Default mailbox setting whether to store attachments."
msgstr "Definição padrão da caixa de correio se armazena-se anexos ou não."

#: src/config/settings.py:1028
msgid ""
"Default number of periods between two runs of a standard routine for a INBOX "
"mailbox."
msgstr ""
"Número padrão de períodos entre duas execuções de uma rotina padrão para uma "
"caixa de entrada da caixa de correio."

#: src/config/settings.py:1034
msgid "Default fetching criterion for a standard routine for a INBOX mailbox."
msgstr ""
"Critérios padrão de busca para uma rotina padrão para uma caixa de entrada "
"de uma caixa de correio."

#: src/config/settings.py:1040
msgid ""
"Default number of periods between two runs of a standard routine for a SENT "
"mailbox."
msgstr ""
"Número padrão de períodos entre duas execuções de uma rotina padrão para uma "
"caixa de envios da caixa de correio."

#: src/config/settings.py:1046
msgid "Default fetching criterion for a standard routine for a SENT mailbox."
msgstr ""
"Critério padrão de busca para uma rotina padrão para a caixa de envios da "
"caixa de correio."

#: src/config/settings.py:1052
msgid ""
"Set this to True to allow new users to sign up themselves. This setting only "
"takes effect if the REGISTRATION_ENABLED environment setting is not 0."
msgstr ""
"Defina isto para True para permitir novos utilizadores inscreverem-se. Esta "
"definição apenas tem efeito se a definição de ambiente REGISTRATION_ENABLED "
"é definida para 0."

#: src/config/settings.py:1059
msgid ""
"Set this to True to tolerate connections involving an unverified SSL "
"certificate, e.g. a self-signed one."
msgstr ""
"Defina isto para True para tolerar conexões envolvendo um certificado SSL "
"não verificado, p.ex. um certificado auto-assinado."

#: src/config/settings.py:1066
msgid ""
"Emails are auto-deleted this number of days past their 'Received' timestamp. "
"A non-positive number disables auto-deletion."
msgstr ""
"Emails são eliminados automaticamente este número de dias após a data de "
"'Recebido'. Um número não positivo desativa auto eliminação."

#: src/config/settings.py:1074
msgid "Server Configurations"
msgstr "Configurações de Servidor"

#: src/config/settings.py:1081
msgid "Default Values"
msgstr "Valores Padrão"

#: src/config/settings.py:1092
msgid "Processing Settings"
msgstr "Definições de Processamento"

#: src/config/settings.py:1103
msgid "Storage Settings"
msgstr "Definições de Armazenamento"

#: src/config/settings.py:1110
msgid "API Settings"
msgstr "Definições de API"

#: src/config/settings.py:1117
msgid "Web Settings"
msgstr "Definições Web"
